// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// We specify 'sqlserver' to connect to Azure SQL Database
datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// User model based on class diagram and entities.ts
model User {
  userId      String     @id @default(uuid())
  displayName String
  email       String     @unique // Email must be unique
  role        String     @default("STUDENT") // Default new users to Student
  createdAt   DateTime   @default(now())
  
  // Relations
  slots       TimeSlot[] @relation("InstructorSlots")
  bookings    Booking[]  @relation("StudentBookings")
}

// TimeSlot model based on class diagram and entities.ts
model TimeSlot {
  slotId        String   @id @default(uuid())
  instructorId  String
  startTime     DateTime
  endTime       DateTime
  location      String
  isBooked      Boolean  @default(false)
  createdAt     DateTime @default(now())

  // Relation to the instructor
  instructor    User     @relation("InstructorSlots", fields: [instructorId], references: [userId])
  
  // Relation to a booking (a slot can have one booking)
  booking       Booking?
}

// Booking model based on class diagram and entities.ts
model Booking {
  bookingId String        @id @default(uuid())
  slotId    String        @unique // Enforces 1:1 relation with TimeSlot
  studentId String
  createdAt DateTime      @default(now())
  status    String        @default("CONFIRMED")
  notes     String?

  // Relation to the student
  // FIX: We add onDelete/onUpdate: NoAction to break the referential cycle.
  student   User     @relation("StudentBookings", fields: [studentId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  
  // Relation to the slot
  slot      TimeSlot @relation(fields: [slotId], references: [slotId])
}